# Jeux et sauvegardes, y compris extensions majuscules et copies de sauvegarde.
*.[nN][dD][sS]
*.[nN][dD][sS].*
*.[gG][bB][aA]
*.[gG][bB]
*.[gG][bB][cC]
*.[rR][oO][mM]
*.[sS][aA][vV]
*.[sS][aA][vV].*
*.[dD][sS][vV]
*.[dD][sS][vV].*
*.[dD][sS][tT]
*.[dD][sS][0-9]
*.[dD][uU][cC]
*.[sS][rR][mM]
*.state*

# Archives locales susceptibles de contenir des ROM ou sauvegardes.
*.[zZ][iI][pP]
*.[7][zZ]
*.[rR][aA][rR]

# Binaires d'émulateur et bibliothèques Lua fournis par l'installation locale.
*.exe
*.dll

